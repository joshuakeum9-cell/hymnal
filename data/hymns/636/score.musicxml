    <lyric number="1">
     <syllabic>single</syllabic>
     <text xml:lang="ko">이름이 거룩히 여김을</text>
    </lyric>
    <lyric number="3">
     <syllabic>single</syllabic>
     <text xml:lang="ko">이룬 것 같이 땅에서도</text>
    </lyric>
    <lyric number="5">
     <syllabic>single</syllabic>
     <text xml:lang="ko">양식을</text>
    </lyric>
    <lyric number="7">
     <syllabic>single</syllabic>
     <text xml:lang="ko">우리 죄를 사하여</text>
    </lyric>
    <lyric number="9">
     <syllabic>single</syllabic>
     <text xml:lang="ko">다만 악에서</text>
    </lyric>
    <lyric number="11">
     <syllabic>single</syllabic>
     <text xml:lang="ko">아버지께 영원히</text>
    </lyric>
