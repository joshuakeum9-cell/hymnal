{
  "name": "hymnal",
  "private": true,
  "version": "1.0.0",
  "description": "새찬송가 band hymnal: search by number, transpose to any key, Korean and English lyrics",
  "type": "module",
  "scripts": {
    "data": "python tools/build_data.py && python tools/subset_fonts.py",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "python tools/check_data.py"
  },
  "license": "MIT",
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "opensheetmusicdisplay": "^2.1.3",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
